# База данных PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=root
DB_PASS=root
DB_NAME=RIP

# JWT для авторизации (лаба 4). Любая длинная случайная строка.
JWT_SECRET=change-me-to-a-long-random-string

# Redis для blacklist отозванных токенов (лаба 4).
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=password
