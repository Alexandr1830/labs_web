@base = http://localhost:8080/api

### Auth: register
POST {{base}}/auth/register
Content-Type: application/json

{
  "username": "new user",
  "email": "new@mail.ru",
  "password": "pass123"
}

### Auth: login
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "ivanov@mail.ru",
  "password": "hash123"
}

### Auth: logout
POST {{base}}/auth/logout

### Profile: get
GET {{base}}/profile

### Profile: update
PUT {{base}}/profile
Content-Type: application/json

{
  "username": "Иван Иванов",
  "email": "ivanov@mail.ru",
  "password": ""
}

### Services: list (filter by status, q)
GET {{base}}/services?status=active&q=API

### Services: one
GET {{base}}/services/1

### Services: create
POST {{base}}/services
Content-Type: application/json

{
  "title": "Новая услуга",
  "type": "doc",
  "description": "Описание",
  "status": "active"
}

### Services: update
PUT {{base}}/services/1
Content-Type: application/json

{
  "title": "Обновлённая услуга",
  "type": "doc",
  "description": "Новое описание",
  "status": "active"
}

### Services: delete (logical)
DELETE {{base}}/services/1

### Services: upload image (multipart)
POST {{base}}/services/1/image
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="image.png"
Content-Type: image/png

< ./resources/img/doc.png
--boundary--

### Cart: icon
GET {{base}}/cart

### Add service to draft
POST {{base}}/services/1/add-to-cart

### Applications: list (filter by status and formed_at range)
GET {{base}}/applications?status=formed&from=2025-01-01&to=2026-12-31

### Applications: one
GET {{base}}/applications/1

### Applications: update fields (title/description only)
PUT {{base}}/applications/1
Content-Type: application/json

{
  "title": "Заявка на услуги",
  "description": "Комментарий"
}

### Applications: submit (draft -> formed, only creator)
PUT {{base}}/applications/1/submit

### Applications: complete (formed -> completed, only moderator)
PUT {{base}}/applications/1/complete

### Applications: reject (formed -> rejected, only moderator)
PUT {{base}}/applications/1/reject

### Applications: delete (only own draft)
DELETE {{base}}/applications/1

### Application services: update qty/position/is_primary
PUT {{base}}/applications/1/services/1
Content-Type: application/json

{
  "quantity": 2,
  "position": 1,
  "is_primary": true
}

### Application services: delete
DELETE {{base}}/applications/1/services/1
